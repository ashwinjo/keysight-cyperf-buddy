# ============= DATABASE =============
DATABASE_URL=postgresql://cyperf_dev:cyperf_dev_password@localhost:5432/cyperf_cve_dev

# ============= REDIS =============
REDIS_URL=redis://localhost:6379/0

# ============= NVD API =============
NVD_API_KEY=<your-nvd-api-key-here>

# ============= CYPERF CREDENTIALS =============
# REQUIRED: Obtain from Keysight or internal Cyperf Controller
CYPERF_CONTROLLER_IP=192.168.1.100
CYPERF_USERNAME=admin
CYPERF_PASSWORD=<cyperf-password-here>

# ============= APPLICATION CONFIG =============
ENVIRONMENT=development
LOG_LEVEL=DEBUG
CYPERF_SYNC_INTERVAL_HOURS=24

# ============= EMAIL SERVICE (Phase 4.1 - Sales Funnel) =============
# Obtain SMTP credentials from Keysight IT or use an app-specific account.
# Use STARTTLS (port 587) or implicit TLS (port 465).
# Rotate SMTP_PASSWORD quarterly. Never commit this file to git.
SMTP_SERVER=mail.keysight.com
SMTP_PORT=587
SMTP_USERNAME=cyperf-tracker@keysight.com
SMTP_PASSWORD=<set-app-specific-password>
SMTP_FROM_EMAIL=cyperf-tracker@keysight.com
SMTP_RECIPIENT_EMAIL=ashwin.joshi@keysight.com

# To run the live SMTP integration test (sends a real email):
# SMTP_LIVE_TEST=true pytest backend/tests/test_contact_e2e.py -v

# ─── L4-7 Test Advisor Agent ──────────────────────────────────────────────
# REQUIRED for agent service. Get from: https://aistudio.google.com/app/apikey
# Without this key the agent container will exit on startup.
GEMINI_API_KEY=<your-gemini-api-key-here>
